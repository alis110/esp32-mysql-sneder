# Python / venv / cache
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv38-x86/
.py38-win32/
_win7build/
venv/
*.egg-info/
.pytest_cache/

# Archived old project (heavy: firmware libs, dist, tools, dumps)
old/

# Secrets / runtime
config/config.ini
firmware/include/secrets.h
data/*
!data/.gitkeep
lab/receiver/data/
logs/
*.log

# ESP32-S3 build artifacts
